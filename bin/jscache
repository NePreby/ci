#!/usr/bin/env bash
# jscache — Next's build cache, pnpm's record of a verified lockfile and npm's
# download cache, carried between runners through the org's store (bin/cache).
#
#   jscache restore   # right before the gate
#   jscache save      # after the gate, and after a site build: writes on a trusted ref
#
# .next/cache, keyed by commit, for every package in the repo that depends on
# next — the root, or apps/docs in a workspace — in one archive, each under a
# label named for its directory. The compile store is valid across commits (Next
# checks what it reads), so every trusted run writes its own and restores the
# newest, and bin/cache keeps two. hanzoai/community compiles in 1.7 s from it
# and 9.7 to 27.8 s without.
#
# pnpm 11 checks a lockfile against its supply-chain policies on every install,
# fetching each entry's packument first: 1 m 54 s to 1 m 59 s of an install on
# hanzoai/community and hanzoai/help-site (runs 40304493306, 40304515329). It
# records a lockfile that passed in lockfile-verified.jsonl in its cache dir, and
# a --frozen-lockfile install that finds the record skips the check. That one
# file is carried, keyed by the lockfile and the workspace file, and saved after
# the gate's own frozen install wrote it.
#
# npm ci fetches every tarball its cache does not hold, and pkg.hanzo.ai served
# hanzoai/computer's 1,011 in 3 minutes (run 40308075765). npm's cache is
# content-addressed by each package's integrity, so it is carried for a root
# package-lock.json, keyed by it; a lockfile that moved restores the newest and
# fetches only what changed.
#
# node_modules is not carried. On a runner, restoring it cost more than the
# install it replaced (hanzoai/community run 40297610093: 54 s to unpack 154 MiB,
# then pnpm 11 still verified the lockfile against the registry for 56 s,
# against 46 to 60 s for a cold install), and a tree that size in the workspace
# is walked by every later `hashFiles('**/…')`, 218 s in that run.
#
# Best effort, like bin/cache: nothing here fails a gate.
set -uo pipefail
cmd=${1:-}
case "$cmd" in restore|save) ;; *) echo "usage: jscache restore|save" >&2; exit 2 ;; esac
skip() { echo "::notice::jscache: $*"; exit 0; }
CACHE="$(dirname "$0")/cache"

# The publish job compiles only when hanzo.yml names a site build.
if [ "${HANZO_CI_ROLE:-}" = publish ] && [ -z "$("$(dirname "$0")/sites" build 2>/dev/null)" ]; then
  skip "the publish job builds nothing here, so it needs no Next cache"
fi
v=$(node -p process.version 2>/dev/null) || skip "node is not on this runner"
# A new name when what an archive holds changes, so none written before is read.
next="next-$v-$(uname -m)"
key=$(printf '%s' "${GITHUB_SHA:-$(git rev-parse HEAD)}" | cut -c1-40)
# Each package that depends on next, three levels down at most, as
# <label>=<dir>/.next/cache; the label is the directory, which bin/cache
# requires to be one plain name. A build's own output is not a package: Next
# writes .next/package.json.
apps=()
while IFS= read -r pj; do
  jq -e '(.dependencies // {}) + (.devDependencies // {}) | has("next")' "$pj" >/dev/null 2>&1 || continue
  d=$(dirname "$pj"); d=${d#./}
  if [ "$d" = . ]; then apps+=("n_root=.next/cache"); else apps+=("n_$(printf '%s' "$d" | tr -c 'A-Za-z0-9._-' '_')=$d/.next/cache"); fi
done < <(find . -maxdepth 3 -name package.json -not -path '*/node_modules/*' -not -path './.*/*' -not -path '*/.next/*' 2>/dev/null | awk '{print (($0 == "./package.json") ? 0 : 1) "\t" $0}' | sort | cut -f2)
# pnpm's verified-lockfile record, for a root pnpm-lock.yaml under pnpm 11 or later.
record= rkey= rname= rdir="${RUNNER_TEMP:-${TMPDIR:-/tmp}}/jscache-verified"
if [ -f pnpm-lock.yaml ] && pv=$(pnpm --version 2>/dev/null) && [ "${pv%%.*}" -ge 11 ] 2>/dev/null; then
  record="$(pnpm cache path 2>/dev/null)/lockfile-verified.jsonl"
  rname="pnpm-verified-$pv"
  rkey=$(git ls-tree HEAD -- pnpm-lock.yaml pnpm-workspace.yaml 2>/dev/null | sha256sum | cut -c1-32)
fi
# npm's download cache, for a root package-lock.json.
npmc= nkey=
if [ -f package-lock.json ] && npmc=$(npm config get cache 2>/dev/null) && [ -n "$npmc" ]; then
  npmc="$npmc/_cacache"
  nkey=$(git ls-tree HEAD -- package-lock.json 2>/dev/null | sha256sum | cut -c1-32)
fi
[ ${#apps[@]} -gt 0 ] || [ -n "$record" ] || [ -n "$nkey" ] || skip "nothing here depends on next, installs with pnpm 11 or has a package-lock.json"

if [ "$cmd" = restore ]; then
  [ ${#apps[@]} = 0 ] || GITHUB_OUTPUT=/dev/null "$CACHE" restore "$next" "$key" "${apps[@]}"
  if [ -n "$record" ]; then
    rm -rf "$rdir"
    GITHUB_OUTPUT=/dev/null "$CACHE" restore "$rname" "$rkey" "v=$rdir"
    [ ! -f "$rdir/lockfile-verified.jsonl" ] || { mkdir -p "$(dirname "$record")" && cp "$rdir/lockfile-verified.jsonl" "$record"; }
  fi
  [ -z "$nkey" ] || GITHUB_OUTPUT=/dev/null "$CACHE" restore npm-cache "$nkey" "c=$npmc"
  exit 0
fi

[ -z "$nkey" ] || [ ! -d "$npmc" ] || "$CACHE" save npm-cache "$nkey" "c=$npmc"

if [ -n "$record" ] && [ -f "$record" ]; then
  rm -rf "$rdir"; mkdir -p "$rdir" && cp "$record" "$rdir/" && "$CACHE" save "$rname" "$rkey" "v=$rdir"
fi

have=()
for a in "${apps[@]}"; do
  d=${a#*=}
  [ -d "$d" ] || continue
  # What no later build reads: the fetch cache holds responses, not compiles.
  rm -rf "$d/fetch-cache"
  have+=("$a")
done
[ ${#have[@]} = 0 ] || "$CACHE" save "$next" "$key" "${have[@]}"
