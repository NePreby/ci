#!/usr/bin/env bash
# gocache — this org's Go build cache and module downloads, carried between runners.
#
#   gocache restore <module-dir>   # starts the cache every later go command in this job uses
#   gocache save    <module-dir>   # writes what this job built (a trusted ref only), then stops it
#
# A runner is a pod that lives for one job, so a cache on its disk dies with it.
# The program in gocache/ (its own module, standard library only, built here
# with the job's own toolchain) runs once per job and answers every go command
# through GOCACHEPROG, fetching each compiled package from the org's store the
# first time a build asks for it, and serves the module files the store holds
# as the first entry in GOPROXY. Nothing is restored before the gate starts.
#
# WHY NOT AN ARCHIVE. This used to restore one tar of GOCACHE and GOMODCACHE per
# go.sum: hanzo-inc/cloud's shares carried 2.4-4.5 GiB each and spent 110 to 1157
# seconds restoring before a compile could begin (runs 16846, 16941), longer
# than their tests on the small shares, and every job fetched all of it whatever
# it built. Here a job fetches what it reads, and a save uploads only what the
# store lacks.
#
# WHO WRITES: the default branch and tags (bin/cache trusted), never a pull
# request, because the go command trusts a cached output it did not build. Each
# output is named by the SHA-256 of its bytes and every fetch is checked
# against that name. A save runs after a red gate too: an output is valid for
# the inputs that produced it whatever the tests then said.
#
# Go 1.24 or newer (GOCACHEPROG). Older toolchains build cold, and say so.
#
# ENV: HANZO_API_TOKEN (the org's IAM bearer, which the KMS step exports),
# HANZO_API, CACHE_BUCKET, and GITHUB_* for the repository and the ref.
set -uo pipefail

cmd="${1:-}"; dir="${2:-.}"
skip() { echo "::notice::gocache: $*"; exit 0; }
case "$cmd" in restore|save) ;; *) echo "usage: gocache restore|save <module-dir>" >&2; exit 2 ;; esac
command -v go >/dev/null 2>&1 || skip "go is not on this runner"

state="${RUNNER_TEMP:-${TMPDIR:-/tmp}}/gocache"

if [ "$cmd" = save ]; then
  [ -s "$state/ready" ] || skip "no cache was started in this job, so there is nothing to save"
  "$state/gocache" flush "$(cat "$state/ready")"
  grep -v '^$' "$state/log" 2>/dev/null | tail -5 | sed 's/^/  /'
  exit 0
fi

[ -f "$dir/go.mod" ] || skip "$dir has no go.mod"
v=$(go env GOVERSION)
case "$v" in
  go1.2[4-9]*|go1.[3-9][0-9]*|go[2-9]*) ;;
  *) skip "$v predates GOCACHEPROG (Go 1.24), so this job builds cold" ;;
esac

rm -rf "$state"; mkdir -p "$state"
arch=$(go env GOARCH)
# The program itself comes from the store, keyed by its source and the
# toolchain: building it from nothing compiles net/http and crypto/tls, 36 s of
# a warm job (hanzoai/orm). The job's own toolchain builds it on a miss, never
# another: the module says go 1.24, and nothing here may reach for a download
# the gate did not ask for.
src="$(dirname "$0")/../gocache"
self=$(cat "$src"/go.mod "$src"/*.go | sha256sum | cut -c1-32)
GITHUB_OUTPUT="$state/hit" "$(dirname "$0")/cache" restore "gocache-$v-$arch" "$self" bin="$state/bin" > /dev/null
if [ ! -x "$state/bin/gocache" ]; then
  mkdir -p "$state/bin"
  if ! (cd "$src" && GOTOOLCHAIN=local GOWORK=off GOFLAGS= CGO_ENABLED=0 \
        GOCACHE="$state/self" go build -trimpath -o "$state/bin/gocache" .) > "$state/log" 2>&1; then
    sed 's/^/  /' "$state/log"
    skip "the cache program did not build, so this job builds cold"
  fi
  rm -rf "$state/self"
  "$(dirname "$0")/cache" save "gocache-$v-$arch" "$self" bin="$state/bin" > /dev/null
fi
ln -s bin/gocache "$state/gocache"

write=
"$(dirname "$0")/cache" trusted && write=-write
mods=$(go env GOMODCACHE)
prefix="${GITHUB_REPOSITORY:-local/local}/gocache/$v-$(go env GOOS)-$arch"
# Which gate this job runs (build.yml: the share and the scope it was handed), so
# its last run's entries are fetched ahead of the build.
scope=$(printf '%s' "${GOCACHE_SCOPE:-}" | sha256sum | cut -c1-16)
# Its own session, so it outlives this step and every step after it; the runner
# ends it with the job.
launch=(nohup)
command -v setsid >/dev/null 2>&1 && launch=(setsid nohup)
"${launch[@]}" "$state/gocache" serve -dir "$state/dir" -sock "$state/sock" -ready "$state/ready" \
  -prefix "$prefix" -scope "$scope" -mods "$mods" $write >> "$state/log" 2>&1 < /dev/null &

# serve writes ready once the store's index is read (it gives up on that after two
# minutes and serves what it has), so the first go command already sees it.
for _ in $(seq 1 1300); do [ -s "$state/ready" ] && break; sleep 0.1; done
[ -s "$state/ready" ] || { sed 's/^/  /' "$state/log"; skip "the cache did not start, so this job builds cold"; }
addr=$(cat "$state/ready")

# First in GOPROXY, with `|` after it: a miss or a fault there sends the go
# command on to whatever GOPROXY already named. A GOPROXY that forbids
# downloading (`off`) is left as it is.
up=$(go env GOPROXY)
case ",${up//|/,}," in
  *,off,*) proxy=$up ;;
  *) proxy="http://$addr|$up" ;;
esac
{
  echo "GOCACHEPROG=$state/gocache connect $state/sock $state/dir"
  echo "GOPROXY=$proxy"
  # Every later step reads the caches from these directories, so a gate that
  # names its own with `${GOCACHE:-…}` (hanzo-inc/cloud's do) builds into them.
  echo "GOMODCACHE=$mods"
  echo "GOCACHE=$(go env GOCACHE)"
} >> "${GITHUB_ENV:-/dev/null}"
grep -h 'index:\|own disk' "$state/log" | sed 's/^/  /'
if [ -n "$write" ]; then echo "gocache: $prefix, writing what this job builds"; else echo "gocache: $prefix, read only"; fi
